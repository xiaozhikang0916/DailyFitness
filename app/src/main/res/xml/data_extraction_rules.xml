<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules for API 31+ (android:dataExtractionRules).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes

   The AI Coach API key (DataStore file under files/datastore/) is excluded from
   both cloud backup and device transfer (M3.4 / privacy decision A3).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/ai_coach_config.preferences_pb"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/ai_coach_config.preferences_pb"/>
    </device-transfer>
</data-extraction-rules>
